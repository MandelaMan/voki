DATABASE_URL="mysql://voki:voki@localhost:3306/voki"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
UPLOAD_DIR=uploads
FRONTEND_URL=http://localhost:5173

# Dev test user (created via: npm run db:seed). This stays a normal shop account.
TEST_USER_EMAIL=test@voki.local
TEST_USER_PASSWORD=password123
TEST_USER_FIRST_NAME=Test
TEST_USER_LAST_NAME=User

# Platform super admin. Created on API start. These defaults are used when the
# variables are missing, including on Render, so the deployed site can sign in.
# Extra comma-separated emails are promoted if those people already have accounts.
SUPER_ADMIN_EMAIL=admin@voki.local
SUPER_ADMIN_PASSWORD=VokiAdmin2026
SUPER_ADMIN_FIRST_NAME=Voki
SUPER_ADMIN_LAST_NAME=Admin

# Premium billing. In development, payments are simulated until these are set.
PREMIUM_PRICE_KES=999
PREMIUM_PERIOD_DAYS=30
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ACCOUNT_REF=VOKI
MPESA_CALLBACK_URL=
API_PUBLIC_URL=http://localhost:3001

# Product photo background removal (https://www.remove.bg/api)
REMOVEBG_API_KEY=
